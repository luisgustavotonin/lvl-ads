{
  "name": "KpiTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do modelo de KPIs (ex: Modelo WhatsApp, Modelo E-commerce)"
    },
    "unit_id": {
      "type": "string",
      "description": "ID da unidade associada ('global' para templates reutiliz\u00e1veis)"
    },
    "selected_kpis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de IDs de KPIs selecionados no template"
    },
    "is_default": {
      "type": "boolean",
      "default": false,
      "description": "Se este \u00e9 o template padr\u00e3o"
    }
  },
  "required": [
    "name",
    "unit_id",
    "selected_kpis"
  ]
}